    {
      "id": "BR-2026-0003",
      "title": "emSign Root CA - C1 / emSign ECC Root CA - C3 planned removal from Mozilla NSS (info only; not the compromise)",
      "kind": "ca_info",
      "published_at": "2026-10-21",
      "severity_rank": 9,
      "references": [
