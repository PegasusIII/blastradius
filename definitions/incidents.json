    {
      "id": "BR-2026-0002",
      "title": "eMudhra emSign ECC Root CA - G3 removed from Mozilla NSS (compromised intermediates, Oct 2026)",
      "kind": "ca_distrust",
      "published_at": "2026-10-21",
      "severity_rank": 1,
      "references": [
        "https://blog.mozilla.org/security/2026/10/20/protecting-firefox-users-following-the-compromise-of-emudhra-intermediate-certificates/",
        "https://bugzilla.mozilla.org/show_bug.cgi?id=2083449",
        "https://bugzilla.mozilla.org/show_bug.cgi?id=2083709",
        "https://archlinux.org/news/update-to-ca-certificates-mozilla-31311-1-to-prevent-man-in-the-middle-attacks/",
        "https://emudhra.com/en/post/certificate-security-incident",
        "https://bugzilla.mozilla.org/show_bug.cgi?id=2084101",
        "https://ccadb.my.salesforce-sites.com/mozilla/RemovedCACertificateReportCSVFormat"
      ],
      "verification": {
        "verified": true,
        "how": "Checked 2026-10-26. (1) CCADB Mozilla 'Removed CA Certificate Report' lists 'emSign ECC Root CA - G3' (eMudhra Technologies Limited, serial 3CF607A968700EDA8B84) with SHA-256 86A1ECBA089C4A8D3BBE2734C612BA341D813E043CF9E8A862CD5C57A36BBE6B (matches our bundle-computed value), removal bug 2084101, NSS release when removed '3.132' (Mozilla blog / Arch news say 3.131.1; we report the discrepancy and do not use a version rule). (2) Bug 2084101 'Remove eMudhra emSign Root CA - G3 from NSS' (RESOLVED FIXED, nss rev 26d38a0c3fb8) blocks incident bug 2083449, so Mozilla's own records tie the G3 removal to the compromise. (3) Bug 2083449 comment 0 lists the 6 compromised TLS intermediates (fingerprints below) with issuer 'emSign Root TLS CA - G3'; that name is not in Mozilla's included or removed reports, so the exact path from these intermediates to emSign ECC Root CA - G3 (presumably a cross-sign) is NOT verified. Sectigo cross-signed copies of the intermediates exist (bug 2083449) but their full fingerprint list was not sourced. Fixed distro ca-certificates versions not verified except Arch."
      },
      "rules": [
        {
          "type": "cert_fingerprint_present",
          "stores": [
            "os_ca",
            "certifi",
            "java",
            "leaf_chain"
          ],
          "certs": [
            {
              "label": "emSign ECC Root CA - G3",
              "sha256": "86A1ECBA089C4A8D3BBE2734C612BA341D813E043CF9E8A862CD5C57A36BBE6B",
              "verified": true,
              "reason": "removed from NSS for this incident: CCADB removed report + Mozilla bug 2084101 (blocks 2083449)"
            }
          ]
        },
        {
          "type": "cert_fingerprint_present",
          "stores": [
            "leaf_chain"
          ],
          "certs": [
            {
              "label": "EM EV TLS CA - G3B",
              "sha256": "E7568FE6E12331F4FD7DE61DA4C7559D0F8EB192A218D4741A3BA75184333838",
              "verified": true,
              "reason": "compromised intermediate (caCompromise), Mozilla bug 2083449 comment 0"
            },
            {
              "label": "EM OV TLS CA - G3B",
              "sha256": "98B896625C0C230ADEEC3EB2CF6AAD5001ECF9156A68644E82374CE5833BC25B",
              "verified": true,
              "reason": "compromised intermediate (caCompromise), Mozilla bug 2083449 comment 0"
            },
            {
              "label": "EM DV TLS CA - G3B",
              "sha256": "42C4ACCD12C4F59597925E1A08A7A90102608543809308D50EC427E118BA1493",
              "verified": true,
              "reason": "compromised intermediate (caCompromise), Mozilla bug 2083449 comment 0"
            },
            {
              "label": "EM EV TLS CA - G3C",
              "sha256": "432EC25F0D28DE9006D97BF752F17BBB2CD41F669933FCB072D9A1148D0261F3",
              "verified": true,
              "reason": "compromised intermediate (caCompromise), Mozilla bug 2083449 comment 0"
            },
            {
              "label": "EM OV TLS CA - G3C",
              "sha256": "CB6E15165AC802E9B3F993F16C25D41F4E81C21EBDE71AE1B012AC00BF9C7C3F",
              "verified": true,
              "reason": "compromised intermediate (caCompromise), Mozilla bug 2083449 comment 0"
            },
            {
              "label": "EM DV TLS CA - G3C",
              "sha256": "0164D7CEAE5BB909C272AF151FF44B1177AE9B47D9424B94F1D9558C30934D19",
              "verified": true,
              "reason": "compromised intermediate (caCompromise), Mozilla bug 2083449 comment 0"
            }
          ]
        },
        {
          "type": "issuer_name_match",
          "stores": [
            "leaf"
          ],
          "issuer_cn": [
            "emSign ECC Root CA - G3",
            "emSign Root TLS CA - G3",
            "EM EV TLS CA - G3B",
            "EM OV TLS CA - G3B",
            "EM DV TLS CA - G3B",
            "EM EV TLS CA - G3C",
            "EM OV TLS CA - G3C",
            "EM DV TLS CA - G3C"
          ]
        }
      ],
      "remediation": {
        "dpkg": [
          "sudo apt-get update",
          "sudo apt-get install --only-upgrade ca-certificates",
          "sudo update-ca-certificates --fresh"
        ],
        "rpm": [
          "sudo dnf upgrade ca-certificates",
          "sudo update-ca-trust"
        ],
        "apk": [
          "sudo apk update",
          "sudo apk upgrade ca-certificates",
          "sudo update-ca-certificates"
        ],
        "certifi": [
          "<venv>/bin/pip install --upgrade certifi   # run for each listed virtualenv/site-packages"
        ],
        "java": [
          "Upgrade the JDK/JRE package (or remove the alias with: keytool -delete -alias <alias> -keystore <cacerts>)"
        ],
        "leaf": [
          "Reissue the listed certificate from a CA that does not chain to eMudhra/emSign, deploy it, reload the service"
        ],
        "any": [
          "If your distro has no update yet, remove the listed roots from your local trust store per your distro's docs."
        ]
      }
